# ==============================================================
# VPS & Production Environment Configuration
# ==============================================================

# Port to expose on VPS (defaults to 80 for standard HTTP traffic)
# Change to 3000 or 8080 if using a reverse proxy (e.g. Nginx, Caddy, Cloudflare Tunnel)
PORT=80

# Application Environment
NODE_ENV=production

# EmailJS Service Configuration (Enquiry notifications to adityafoodsandmedia.it@gmail.com)
VITE_EMAILJS_SERVICE_ID="service_8t9hii7"
VITE_EMAILJS_TEMPLATE_ID="template_5cr2p9r"
VITE_EMAILJS_PUBLIC_KEY="NRR8qm8gASuExLMKY"

# Optional: Express SMTP Email Gateway (Only required if running Dockerfile.node backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=adityafoodsandmedia.it@gmail.com
SMTP_PASS=your_gmail_app_password
