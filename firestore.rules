rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products: Public read-only catalog. Managed securely via Firebase Console.
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Videos: Public read-only showcase. Managed securely via Firebase Console.
    match /videos/{videoId} {
      allow read: if true;
      allow write: if false;
    }

    // Portfolio: Public read-only project showcase. Managed securely via Firebase Console.
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if false;
    }

    // Settings: Public read-only site configuration. Managed securely via Firebase Console.
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if false;
    }

    // Enquiries: Public booking & contact submissions (create only).
    // Visitors can submit enquiries, but cannot read, update, or delete other people's inquiries.
    // Management is done securely directly in Firebase Console.
    match /enquiries/{enquiryId} {
      allow create: if isValidId(enquiryId)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.email is string
        && request.resource.data.phone is string;
      allow read, update, delete: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
