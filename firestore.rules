rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Products: Public catalog, admin/portal management
    match /products/{productId} {
      allow read: if true;
      allow write: if isValidId(productId);
    }

    // Videos: Public media showcase, admin/portal management
    match /videos/{videoId} {
      allow read: if true;
      allow write: if isValidId(videoId);
    }

    // Portfolio: Public project showcase, admin/portal management
    match /portfolio/{portfolioId} {
      allow read: if true;
      allow write: if isValidId(portfolioId);
    }

    // Settings: Public configuration read, admin/portal updates
    match /settings/{settingsId} {
      allow read: if true;
      allow write: if isValidId(settingsId);
    }

    // Enquiries: Public booking submission, admin/portal list and status updates
    match /enquiries/{enquiryId} {
      allow read: if true;
      allow write: if isValidId(enquiryId);
    }

    // Admins registry: Read and write for administrative configurations
    match /admins/{adminId} {
      allow read, write: if isValidId(adminId);
    }
  }
}
